# Habitica test-account credentials (local only — never commit the real .env)
# Used for dev prefill of the read-only import adapter.
# In production builds there is no credential path: the player enters
# credentials in the Character panel and they stay in memory only.
HABITICA_USER_ID=
HABITICA_API_TOKEN=

# X-Client identity for the read-only import adapter: the TOOL CREATOR's
# public Habitica user id (not a secret, never the player's own id — the
# player id travels in x-api-user). Empty falls back to the built-in default
# creator id in src/ui/habitica-local.ts.
VITE_HABITICA_CREATOR_ID=

# Public Habitica app name; defaults to glimway.
VITE_HABITICA_APP_NAME=

# Docker Compose deployment (copy this file to .env; never put player tokens here).
# Uses the published GHCR image. Releases also have X.Y.Z, X.Y, sha-* tags.
GLIMWAY_IMAGE_TAG=latest
GLIMWAY_BIND_ADDRESS=127.0.0.1
GLIMWAY_HTTP_PORT=8090
GLIMWAY_CONTAINER_PORT=8090
GLIMWAY_LISTEN=0.0.0.0:8090
GLIMWAY_DB=/data/glimway.sqlite
GLIMWAY_STATIC_DIR=/web
GLIMWAY_HABITICA_URL=https://habitica.com
GLIMWAY_X_CLIENT=5abfd539-22eb-457f-8e2a-9fb3d66731f1-glimway
# false for loopback HTTP quickstart; set true when using the HTTPS profile.
GLIMWAY_COOKIE_SECURE=false
GLIMWAY_PARTY_ADMISSION=true
GLIMWAY_LOGIN_CONCURRENCY=4
GLIMWAY_LOGIN_RATE=10
GLIMWAY_LOGIN_GLOBAL_RATE=60
# Empty trusts none. The optional Caddy container has the fixed IP below.
GLIMWAY_TRUSTED_PROXIES=127.0.0.1,::1,172.30.83.2
GLIMWAY_HABITICA_ASSETS_URL=https://habitica-assets.s3.amazonaws.com/mobileApp/images/
GLIMWAY_SPRITE_CACHE=/data/habitica-sprites
# If changing the container listen port, change this and CONTAINER_PORT too.
GLIMWAY_HEALTHCHECK_URL=http://127.0.0.1:8090/api/health
GLIMWAY_PUBLIC_ORIGIN=https://glimway.example.org
# Choose an unused subnet. If changing PROXY_IP, change TRUSTED_PROXIES too.
GLIMWAY_PROXY_SUBNET=172.30.83.0/24
GLIMWAY_PROXY_IP=172.30.83.2
