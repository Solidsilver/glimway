{
  "about": "npm run test:changed: which Playwright specs to run for which changed files (scripts/e2e-changed.ts). Paths are globs from the repo root (* within a folder, ** across folders). A changed spec always runs itself; a rule marked smoke also runs the smoke tier. Keep this up to date when you add a spec or a game system: an unmapped source file falls back to the smoke tier.",
  "full": [
    "e2e/fixtures.ts",
    "e2e/helpers.ts",
    "e2e/home-helpers.ts",
    "e2e/connected.ts",
    "e2e/global-setup.ts",
    "e2e/server/**",
    "playwright.config.ts",
    "vite.config.ts",
    "package.json",
    "package-lock.json"
  ],
  "ignore": ["**/*.md", "docs/**", ".agent/**", "tests/**", "e2e/changed-map.json", "deploy/**", "content/**", "scripts/*-vectors.ts", "scripts/papers.ts"],
  "rules": [
    {
      "paths": ["src/main.ts", "src/game/main.ts", "src/game/scenes/**", "index.html"],
      "specs": ["quest.spec.ts", "combat.spec.ts"],
      "smoke": true
    },
    {
      "paths": ["src/game/wilds/**", "src/lib/wilds/**", "server/internal/wilds/**", "src/content/echoes.ts", "src/content/expansion-writing.ts", "src/game/expansion.ts"],
      "specs": ["wilds.spec.ts", "wilds-outer.spec.ts", "wilds-screens.spec.ts"]
    },
    {
      "paths": [
        "src/game/entities/homesteads.ts",
        "src/game/homestead.ts",
        "src/game/homeland.ts",
        "src/game/cottage.ts",
        "src/game/commons*.ts",
        "src/lib/homestead*.ts",
        "src/lib/workshop.ts",
        "src/lib/mail.ts",
        "src/ui/HomeBar.svelte",
        "src/ui/home.svelte.ts",
        "src/ui/SilasShop.svelte",
        "src/ui/WorkshopPanel.svelte",
        "src/ui/MailPanel.svelte",
        "server/internal/land/**"
      ],
      "specs": ["homestead.spec.ts", "village.spec.ts", "review-fixes.spec.ts", "review5-fixes.spec.ts", "art-screens.spec.ts"]
    },
    {
      "paths": [
        "src/ui/GateShelfPanel.svelte",
        "server/internal/api/gifts_test.go",
        "e2e/gifts.spec.ts"
      ],
      "specs": ["gifts.spec.ts"]
    },
    {
      "paths": [
        "server/internal/api/crafting.go",
        "src/ui/HearthPanel.svelte",
        "src/ui/DeskPanel.svelte",
        "src/ui/WoodpilePanel.svelte",
        "src/game/items-pass.ts"
      ],
      "specs": ["crafting.spec.ts", "homestead.spec.ts"]
    },
    {
      "paths": [
        "src/game/items*.ts",
        "src/lib/items.ts",
        "src/lib/inventory.ts",
        "src/content/inventory.ts",
        "src/ui/InventoryPanel.svelte",
        "src/ui/inventory.svelte.ts",
        "src/game/entities/item-pickups.ts",
        "src/game/entities/off-hand.ts"
      ],
      "specs": ["items.spec.ts", "inventory.spec.ts", "warden.spec.ts"]
    },
    {
      "paths": ["src/content/heirlooms.ts"],
      "specs": ["heirlooms.spec.ts"]
    },
    {
      "paths": ["src/game/entities/enemies.ts", "src/game/entities/hero.ts", "src/game/entities/projectiles.ts", "src/game/entities/fx.ts", "src/lib/combat.ts"],
      "specs": ["combat.spec.ts", "quest.spec.ts", "naming-screens.spec.ts"]
    },
    {
      "paths": ["src/content/world.ts", "src/game/entities/interactables.ts", "src/game/entities/npcs.ts", "src/ui/DialoguePanel.svelte", "src/game/area/**", "src/game/worlds.ts"],
      "specs": ["quest.spec.ts", "embers.spec.ts", "combat.spec.ts", "touches.spec.ts"]
    },
    {
      "paths": [
        "src/game/link.ts",
        "src/game/session.ts",
        "src/lib/api/**",
        "src/lib/save.ts",
        "src/lib/state.ts",
        "src/content/connected.ts",
        "src/content/connect-guide.ts",
        "src/ui/ConnectGuide.svelte",
        "src/ui/LinkGate.svelte",
        "src/ui/LinkNotice.svelte",
        "src/ui/OriginChoice.svelte",
        "src/ui/InvitePanel.svelte",
        "src/ui/MenuPanel.svelte",
        "src/ui/ConfirmDialog.svelte",
        "src/ui/account.ts",
        "server/internal/api/**",
        "server/internal/store/**",
        "server/internal/habitica/**",
        "server/cmd/**"
      ],
      "specs": ["connected.spec.ts", "connected-screens.spec.ts", "onboarding.spec.ts", "polish.spec.ts"]
    },
    {
      "paths": ["server/internal/rules/**", "src/lib/embers.ts", "src/lib/economy.ts"],
      "specs": ["embers.spec.ts", "connected.spec.ts"]
    },
    {
      "paths": ["src/game/presence*.ts", "src/lib/presence*.ts", "src/content/presence.ts", "src/ui/EmotePicker.svelte", "src/game/entities/remote-players.ts"],
      "specs": ["presence.spec.ts"]
    },
    {
      "paths": [
        "src/lib/papers/**",
        "src/game/papers.ts",
        "src/game/entities/papers.ts",
        "src/content/papers*.ts",
        "src/ui/PaperReader.svelte",
        "src/ui/PapersTab.svelte",
        "src/ui/LibraryPanel.svelte",
        "src/ui/papers.svelte.ts"
      ],
      "specs": ["papers.spec.ts", "papers-screens.spec.ts", "connected.spec.ts"]
    },
    {
      "paths": [
        "src/game/residents.ts",
        "src/content/residents.ts",
        "src/game/entities/village-life.ts",
        "src/game/village.ts",
        "src/lib/village.ts",
        "src/lib/calendar.ts",
        "src/game/clock.ts",
        "src/game/mill-art.ts",
        "src/content/village-notices.ts",
        "src/ui/NoticeBoard.svelte",
        "src/ui/village.svelte.ts"
      ],
      "specs": ["residents.spec.ts", "village.spec.ts", "mill.spec.ts"]
    },
    {
      "paths": [
        "src/game/repairs-art.ts",
        "src/game/entities/repairs.ts",
        "src/game/keepsakes.ts",
        "src/lib/repairs.ts",
        "content/repairs.json",
        "server/internal/api/repairs.go"
      ],
      "specs": ["repairs.spec.ts"]
    },
    {
      "paths": ["src/game/nudges.ts", "src/lib/nudges.ts", "src/lib/habitica/**", "src/ui/habitica-local.ts", "src/ui/NamePrompt.svelte"],
      "specs": ["onboarding.spec.ts", "onboarding-layout.spec.ts", "connected.spec.ts"]
    },
    {
      "paths": ["src/ui/TouchControls.svelte", "src/ui/device.ts", "src/game/entities/touches.ts", "src/content/touches.ts"],
      "specs": ["touch.spec.ts", "touches.spec.ts"]
    },
    {
      "paths": ["src/game/atlas-plan.ts", "src/game/packed.ts", "src/game/textures.ts", "src/game/runtime-art.ts", "src/game/avatar-render.ts", "src/game/entities/avatar.ts", "public/**", "assets/**", "scripts/build-atlases.ts"],
      "specs": ["atlases.spec.ts", "art-screens.spec.ts"]
    },
    {
      "paths": [
        "src/App.svelte",
        "src/ui/Hud.svelte",
        "src/ui/store.svelte.ts",
        "src/ui/Toasts.svelte",
        "src/ui/Banners.svelte",
        "src/ui/Moments.svelte",
        "src/ui/JournalPanel.svelte",
        "src/ui/CharacterPanel.svelte",
        "src/ui/Icon.svelte",
        "src/ui/ArtIcon.svelte",
        "src/ui/focus.ts",
        "src/content/controls.ts",
        "src/game/input.ts",
        "src/game/events.ts",
        "src/game/event-names.ts",
        "src/game/sfx.ts"
      ],
      "specs": ["polish.spec.ts", "quest.spec.ts", "onboarding-layout.spec.ts", "embers.spec.ts"]
    }
  ]
}
