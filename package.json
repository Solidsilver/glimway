{
  "name": "glimway",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run check && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:changed": "node scripts/e2e-changed.ts",
    "test:screens": "SCREENS=1 playwright test",
    "verify:all": "npm run verify && npm run test:e2e",
    "server": "go run ./server/cmd/glimway-server -cookie-secure=false",
    "vectors": "node scripts/backend-vectors.ts",
    "vectors:wilds": "node scripts/wilds-vectors.ts",
    "vectors:homestead": "node scripts/homestead-vectors.ts",
    "vectors:calendar": "node scripts/calendar-vectors.ts",
    "papers": "node scripts/papers.ts",
    "atlases": "node scripts/build-atlases.ts",
    "vectors:items": "node scripts/items-vectors.ts",
    "proto": "sh scripts/proto.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.12.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.28.0",
    "svelte-check": "^4.1.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.5"
  }
}
